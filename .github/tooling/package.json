{
  "name": "fortify-action-tooling",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test *.test.mjs",
    "build": "node build-setup.mjs",
    "generate": "npm run generate:actions && npm run build",
    "generate:actions": "node generate-actions.mjs",
    "check": "node generate-actions.mjs --check && node build-setup.mjs --check && node update-contributing.mjs --check",
    "docs:contributing": "node update-contributing.mjs",
    "docs:check": "node update-contributing.mjs --check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@fortify/setup": "2.1.3",
    "semver": "7.7.2",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "@vercel/ncc": "0.38.1",
    "typescript": "5.3.3"
  }
}